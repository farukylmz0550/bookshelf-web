# Copy to .env for local dev, or to .env for docker-compose (it reads the same file via `env_file`-less var substitution).
# REQUIRED: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:1024
APP_PORT=1024
# Set to "false" to disable public registration (default: true)
ALLOW_REGISTRATION=true
# Required for /api/test/reset — generate with: openssl rand -base64 32
RESET_SECRET=
# Android TWA — SHA256 fingerprint from Google Play Console or keytool
ANDROID_SHA256_FINGERPRINT=

# Web Push (true server push) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Bearer token for the Docker cron service to call /api/push/streak-remind
CRON_SECRET=

# Local dev (SQLite file):
DATABASE_URL="file:./prisma/dev.db"

# v3.0.0 — reading/XP/backfill/Kobo values moved to config.yaml (repo root).
# The file is mounted read-only into the Docker container; see config.yaml.
