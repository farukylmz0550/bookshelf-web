generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  TO_READ
  READING
  FINISHED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  isAdmin           Boolean   @default(false)
  approved          Boolean   @default(false)
  xp                Int       @default(0)
  showOnLeaderboard Boolean   @default(true)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    DateTime?
  streakShieldCount Int       @default(0)
  createdAt         DateTime  @default(now())

  // v2.10.0 — TOTP two-factor auth + forced password change
  totpSecret         String?
  totpEnabled        Boolean @default(false)
  mustChangePassword Boolean @default(false)

  // v3.0.0 — Kobo sync: per-user URL template the device downloads book files
  // from (e.g. "https://nas.local/books/{isbn}.epub"); placeholders are
  // {isbn}, {isbn10}, {isbn13}.
  fileSourceUrl String?

  books           Book[]
  persons         Person[]
  goal            Goal?
  achievements    UserAchievement[]
  dailyActivities DailyActivity[]
  streakShields   StreakShield[]
  settings        UserSettings?
  readEvents      BookReadEvent[]
  groups          BookGroup[]
  koboToken       KoboSyncToken?
  koboSyncedBooks KoboSyncedBook[]
  challenges      Challenge[]
  quotes          Quote[]
  qrLoginSessions QrLoginSession[]

  // v3.16.0 — personal API tokens + extension installs
  apiTokens         ApiToken[]
  extensionInstalls ExtensionUser[]
  extensionStorage  ExtensionStorage[]
  libraryLocations  LibraryLocation[]
  bookCopies        BookCopy[]

  @@index([id])
}

// v3.3.0 — seasonal challenges: free-form reading challenges with a target
// number of read events inside a date window (e.g. "Winter: 5 books").
// Progress derives from BookReadEvent.readAt (canonical counting, same as
// goals); completedAt is set exactly once via a conditional guard.
model Challenge {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  target      Int
  startAt     DateTime
  endAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// v3.0.0 — Kobo eReader sync: one token per user, embedded in the device's
// api_endpoint URL ("/api/kobo/<token>/v1/..."). The token is a capability
// URL the user can re-copy from Settings, so it is stored as-is (low-risk
// scope: read metadata + download files for this user's library only).
model KoboSyncToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
}

model Book {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Core (existing)
  isbn           String?
  title          String
  author         String?
  coverUrl       String?
  coverFetchedAt DateTime?
  status         BookStatus @default(TO_READ)
  addedAt        DateTime   @default(now())
  finishedAt     DateTime?

  // Legacy parity — 17 fields
  subtitle      String?
  publishers    String?
  publishDate   String?
  publishPlaces String?
  editionName   String?
  series        String?
  numberOfPages String?
  languages     String?
  isbn10        String?
  isbn13        String?
  subjects      String?
  rating        Int       @default(0)
  notes         String?
  tags          String? // csv lowercased
  startedAt     DateTime?
  signed        Boolean   @default(false)
  copies        Int       @default(1)
  currentPage   Int?

  // v3.1.0 — Kobo device-reported reading time. SpentReadingMinutes is the
  // device's CUMULATIVE total for the book; the delta per sync feeds
  // DailyActivity.minutesRead. Remaining is informational only.
  koboSpentMinutes     Int  @default(0)
  koboRemainingMinutes Int?

  lendingRecords   LendingRecord[]
  readEvents       BookReadEvent[]
  groupMemberships BookGroupMembership[]
  quotes           Quote[]
  copiesRecords    BookCopy[]

  @@index([userId])
  @@index([tags])
}

// v3.1.0 — per-book Kobo sync state: metadata hash for change detection and
// device archive tombstones. A row whose Book no longer exists is a tombstone:
// the next sync sends IsRemoved to the device and clears the row. The
// non-cascade bookId keeps tombstones alive after cascaded deletes.
model KoboSyncedBook {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  metaHash   String
  archivedAt DateTime?
  syncedAt   DateTime  @default(now())

  @@unique([userId, bookId])
  @@index([userId])
}

// Read sessions (v2.7.0): one row per logged reading event — a book completion
// (FINISHED) or a partial "I read N pages" log. A book can have many events in
// the same month/year (re-reads count). Canonical basis for booksRead stats.
model BookReadEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Denormalized snapshot — survives book edits/deletes
  bookTitle String?
  // null for completions of books without a usable page count
  pagesRead Int?
  readAt    DateTime @default(now())

  @@index([userId, readAt])
  @@index([bookId])
}

// v3.4.0 — user-added quotes/excerpts attached to a book (optional page
// reference). The denormalized bookTitle snapshot survives book edits
// (same convention as BookReadEvent); deleting the book cascades its quotes.
model Quote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookTitle String?
  text      String
  page      Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bookId])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  loans LendingRecord[]

  @@unique([userId, name])
  @@index([userId])
}

model LendingRecord {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Denormalized snapshot — survives book delete via Loan logic (legacy)
  bookTitle    String?
  borrowerName String
  // Optional person link (new)
  personId     String?
  person       Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName   String?
  lentAt       DateTime  @default(now())
  returnedAt   DateTime?
  dueDate      DateTime?

  @@index([bookId])
  @@index([personId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearly      Int       @default(0)
  monthly     Int       @default(0)
  // Goal lock (v2.7.0): targets are confirmed once per calendar year and stay
  // locked until Jan 1 of the next year (server-local clock).
  targetYear  Int?
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Static catalog of achievements; titleKey/descriptionKey reference i18n message keys.
// v2.11.0 — recurrence: NONE = permanent (unlock once), MONTHLY = re-earnable
// every calendar month (period-scoped unlock records).
enum AchievementRecurrence {
  NONE
  MONTHLY
}

model Achievement {
  id             String                @id @default(cuid())
  key            String                @unique
  titleKey       String
  descriptionKey String
  iconKey        String
  recurrence     AchievementRecurrence @default(NONE)

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  // v2.11.0 — unlock period: "" = permanent (no period), "YYYY-MM" = monthly
  // period. SQLite treats NULLs as distinct in unique indexes, so a non-null
  // sentinel ("" for permanent) is what actually makes the constraint below
  // enforce one-unlock-per-user-per-achievement-per-period.
  periodKey     String      @default("")
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId, periodKey])
  @@index([userId])
}

model DailyActivity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  count       Int      @default(1)
  pagesRead   Int      @default(0)
  // v3.1.0 — device-reported reading minutes (Kobo SpentReadingMinutes delta)
  minutesRead Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StreakShield {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled Boolean @default(true)
  streakReminders      Boolean @default(true)
  weeklyDigest         Boolean @default(false)
  // v2.7.0 — calendar-based goal-progress push notifications
  goalReminders        Boolean @default(true)
  // Per-user locale for localized push notifications (synced from the cookie)
  locale               String?
  // v3.5.1 — per-user "I read N pages" step. NULL = follow the site-wide
  // config.yaml pagesPerReadEvent. Clamped by the admin's minPagesPerReadEvent
  // floor (see lib/reading-settings.ts).
  pagesPerReadEvent    Int?

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

// v3.5.1 — site-wide admin-controlled values that must live in the DB (the
// admin panel edits them at runtime, unlike the config.yaml AppConfig).
// Singleton row. minPagesPerReadEvent = 0 disables the floor.
model SiteSettings {
  id                   String @id @default("site")
  minPagesPerReadEvent Int    @default(0)
}

// v3.0.0 — the AppSettings table was removed: site-wide values moved to
// config.yaml (see src/lib/app-config.ts).

// v2.8.0 — personal groups/shelves: user-defined many-to-many organization for
// books. Groups are NOT tags (metadata/genres remain on Book.tags); a book can
// belong to multiple groups and a group can hold many books.
model BookGroup {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  color             String?
  order             Int                   @default(0)
  mode              BookGroupMode         @default(STATIC)
  ruleJson          String?
  lastEvaluatedAt   DateTime?
  evaluationVersion Int                   @default(1)
  createdAt         DateTime              @default(now())
  memberships       BookGroupMembership[]

  @@unique([userId, name])
  @@index([userId])
}

enum BookGroupMode {
  STATIC
  SMART
}

model BookGroupMembership {
  id      String    @id @default(cuid())
  bookId  String
  book    Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  groupId String
  group   BookGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt DateTime  @default(now())

  @@unique([bookId, groupId])
  @@index([bookId])
  @@index([groupId])
}

// v3.18.0 — physical library locations and copy-level placement. The legacy
// Book.copies field remains the compatibility count; copiesRecords is the
// authoritative representation for location-aware features.
enum LibraryLocationKind {
  ROOM
  SECTION
  SHELF
  BOX
}

model LibraryLocation {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     LibraryLocation?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   LibraryLocation[]   @relation("LocationTree")
  kind       LibraryLocationKind
  name       String
  sortOrder  Int                 @default(0)
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  copies     BookCopy[]

  @@unique([userId, parentId, name])
  @@index([userId, parentId])
  @@index([userId, archivedAt])
}

model BookCopy {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  copyNumber Int
  barcode    String?
  locationId String?
  location   LibraryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  condition  String           @default("GOOD")
  createdAt  DateTime         @default(now())
  archivedAt DateTime?

  @@unique([userId, bookId, copyNumber])
  @@unique([userId, barcode])
  @@index([userId, bookId])
  @@index([userId, locationId])
  @@index([userId, barcode])
}

// v3.12.0 — passwordless QR login: single-use, short-lived (60 s) handoff
// tokens. The RAW token is never stored — only its SHA-256 hash — and it is
// never logged. The confirming device atomically claims the row (confirmedAt
// conditional update), then receives a normal NextAuth JWT session; the token
// itself is not a credential.
model QrLoginSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  scannedAt   DateTime?
  confirmedAt DateTime?

  @@index([userId])
}

// v3.16.0 — personal API tokens. The raw token is shown once at creation; only
// its SHA-256 hash is stored. USER tokens are scoped to their owner; ADMIN
// tokens additionally unlock /api/v1/admin/* and cross-user access, and can
// only be created by an admin (TOTP-confirmed when enabled).
enum ApiTokenKind {
  USER
  ADMIN
}

model ApiToken {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       ApiTokenKind @default(USER)
  tokenHash  String       @unique
  prefix     String
  scopes     String
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// v3.16.0 — Chrome-style extension packages. A package lives on disk
// (<data>/extensions/<slug>/<version>) and its validated manifest is mirrored
// here for listing, permission checks and the install UI.
enum ExtensionType {
  THEME
  UI
  SERVER
}

enum ExtensionScope {
  USER
  SERVER
}

model Extension {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  version        String
  type           ExtensionType
  scope          ExtensionScope @default(USER)
  manifest       String
  installPath    String
  enabled        Boolean        @default(false)
  isDefaultTheme Boolean        @default(false)
  // v3.16.0 — per-package HMAC secret (server webhooks) and admin-editable
  // declarative settings (JSON object matching manifest.server.settings).
  secret         String?
  settings       String?
  installedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users   ExtensionUser[]
  storage ExtensionStorage[]

  @@index([type, scope])
}

model ExtensionUser {
  id          String    @id @default(cuid())
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean   @default(true)
  settings    String?
  installedAt DateTime  @default(now())

  @@unique([extensionId, userId])
  @@index([userId])
}

model ExtensionStorage {
  id          String    @id @default(cuid())
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  value       String
  updatedAt   DateTime  @updatedAt

  @@unique([extensionId, userId, key])
  @@index([userId])
}
