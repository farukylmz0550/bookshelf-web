generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  TO_READ
  READING
  FINISHED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  isAdmin            Boolean   @default(false)
  approved           Boolean   @default(false)
  xp                 Int       @default(0)
  showOnLeaderboard  Boolean   @default(true)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActiveDate     DateTime?
  streakShieldCount  Int       @default(0)
  createdAt          DateTime  @default(now())

  // v2.10.0 — TOTP two-factor auth + forced password change
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  mustChangePassword Boolean   @default(false)

  books           Book[]
  persons         Person[]
  goal            Goal?
  achievements    UserAchievement[]
  dailyActivities DailyActivity[]
  streakShields   StreakShield[]
  settings        UserSettings?
  readEvents      BookReadEvent[]
  groups          BookGroup[]

  @@index([id])
}

model Book {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Core (existing)
  isbn           String?
  title          String
  author         String?
  coverUrl       String?
  coverFetchedAt DateTime?
  status         BookStatus @default(TO_READ)
  addedAt        DateTime   @default(now())
  finishedAt     DateTime?

  // Legacy parity — 17 fields
  subtitle       String?
  publishers     String?
  publishDate    String?
  publishPlaces  String?
  editionName    String?
  series         String?
  numberOfPages  String?
  languages      String?
  isbn10         String?
  isbn13         String?
  subjects       String?
  rating         Int        @default(0)
  notes          String?
  tags           String?    // csv lowercased
  startedAt      DateTime?
  signed         Boolean    @default(false)
  copies         Int        @default(1)
  currentPage    Int?

  lendingRecords LendingRecord[]
  readEvents     BookReadEvent[]
  groupMemberships BookGroupMembership[]

  @@index([userId])
  @@index([tags])
}

// Read sessions (v2.7.0): one row per logged reading event — a book completion
// (FINISHED) or a partial "I read N pages" log. A book can have many events in
// the same month/year (re-reads count). Canonical basis for booksRead stats.
model BookReadEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Denormalized snapshot — survives book edits/deletes
  bookTitle String?
  // null for completions of books without a usable page count
  pagesRead Int?
  readAt    DateTime @default(now())

  @@index([userId, readAt])
  @@index([bookId])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  loans LendingRecord[]

  @@unique([userId, name])
  @@index([userId])
}

model LendingRecord {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Denormalized snapshot — survives book delete via Loan logic (legacy)
  bookTitle    String?
  borrowerName String
  // Optional person link (new)
  personId     String?
  person       Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName   String?
  lentAt       DateTime  @default(now())
  returnedAt   DateTime?
  dueDate      DateTime?

  @@index([bookId])
  @@index([personId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearly      Int       @default(0)
  monthly     Int       @default(0)
  // Goal lock (v2.7.0): targets are confirmed once per calendar year and stay
  // locked until Jan 1 of the next year (server-local clock).
  targetYear  Int?
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// Static catalog of achievements; titleKey/descriptionKey reference i18n message keys.
model Achievement {
  id             String @id @default(cuid())
  key            String @unique
  titleKey       String
  descriptionKey String
  iconKey        String

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  count     Int      @default(1)
  pagesRead Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StreakShield {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled  Boolean @default(true)
  streakReminders       Boolean @default(true)
  weeklyDigest          Boolean @default(false)
  // v2.7.0 — calendar-based goal-progress push notifications
  goalReminders         Boolean @default(true)
  // Per-user locale for localized push notifications (synced from the cookie)
  locale                String?

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

// Singleton site settings (v2.7.0) — system-admin editable reading/gamification
// values. Absent row = env-var defaults. Env provides defaults; admin edits win.
// v2.9.0: fixed singleton id ("singleton") — writes are a single upsert, so
// concurrent admin updates can never produce more than one row.
model AppSettings {
  id                  String @id
  pagesPerReadEvent   Int
  xpBookAdded         Int
  xpBookFinishedBase  Int
  xpPagesPer10        Int
  xpLending           Int
  xpPerLevelBase      Int
}

// v2.8.0 — personal groups/shelves: user-defined many-to-many organization for
// books. Groups are NOT tags (metadata/genres remain on Book.tags); a book can
// belong to multiple groups and a group can hold many books.
model BookGroup {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  order     Int                   @default(0)
  createdAt DateTime              @default(now())
  memberships BookGroupMembership[]

  @@unique([userId, name])
  @@index([userId])
}

model BookGroupMembership {
  id      String    @id @default(cuid())
  bookId  String
  book    Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  groupId String
  group   BookGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt DateTime  @default(now())

  @@unique([bookId, groupId])
  @@index([bookId])
  @@index([groupId])
}
